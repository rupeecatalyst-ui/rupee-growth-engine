# RCLIP — Environment Template
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
#
# Supabase connection. The PUBLISHABLE key is safe for the browser bundle
# (VITE_-prefixed values are inlined at build time). The SERVICE_ROLE key is
# secret, server-only, and must never be exposed to the client.

# --- Client + server (public) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- Server only (SECRET — do not prefix with VITE_, do not share) ---
# Used by src/integrations/supabase/client.server.ts for trusted admin operations.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"
